APP_NAME="Associazione Semplice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database condiviso. Due ruoli: l'applicazione (soggetta alla Row-Level Security) e il proprietario
# (solo migrazioni). In locale li crea scripts/db-locale.sh con password di sviluppo.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=as_central
DB_USERNAME=as_app
DB_PASSWORD=app-locale
DB_OWNER_USERNAME=as_owner
DB_OWNER_PASSWORD=owner-locale
DB_BACKUP_USERNAME=as_backup
DB_BACKUP_PASSWORD=backup-locale
DB_RESTORE_DATABASE=as_restore

# Cifratura: in produzione remote (servizio chiavi su un account separato); in locale local con una chiave
# generata da php artisan saas:keys:generate. Mai chiavi vere in questo file.
SAAS_KEY_VAULT=local
SAAS_MASTER_KEY=
SAAS_KEY_SERVICE_URL=
SAAS_KEY_SERVICE_SIGNING_KEY=

# Portale: chiavi pubbliche fissate ("kid=x") e seme della chiave del SaaS (php artisan saas:keys:generate).
SAAS_PORTAL_URL=https://associazionesemplice.it
SAAS_PORTAL_PUBLIC_KEYS=
SAAS_PORTAL_SIGNING_KEY=

# Database dedicati: file JSON fuori dal repository e dalla cartella pubblica.
SAAS_DEDICATED_DB_FILE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true
# In produzione true (HTTPS). In locale su http serve false.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# In produzione redis (64 MB, sempre con scadenza); in locale database.
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@associazionesemplice.it"
MAIL_FROM_NAME="${APP_NAME}"

# Dietro il proxy del portale (associazionesemplice.it/saas/admin|staff|api): indirizzi di cui fidarsi per gli X-Forwarded-*, separati da virgole. Vuoto = nessuno.
SAAS_TRUSTED_PROXIES=
SAAS_PUBLIC_URL=

# Accesso unico dello staff (docs/LOGIN_UNICO_E_DATABASE.md, passo 2): spento finché non è true
SAAS_UNIFIED_LOGIN=false
SAAS_STAFF_SUPPORT_SSO_URL=
