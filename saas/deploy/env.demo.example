# Configurazione della DEMO del gestionale: si copia in ~/saas-demo/shared/.env (permessi 600) e si compila lì, a mano, sul server.
# Mai nel repository e mai in chat. Chiavi, database e utenti PostgreSQL sono DIVERSI da quelli della produzione e da ogni altro posto.
# Solo dati inventati: nessuna posta, nessun pagamento vero, nessun file caricato. Si azzera ogni notte alle 03:30.
#
# La demo ha un account cPanel suo (demosaasassociaz), separato da quello della demo del plugin (WordPress); la regola resta valida
# anche se un giorno i due dividessero l'account: questo file non deve contenere niente che valga altrove (GitHub, portale,
# Emailit/SMTP, Stripe, produzione). Le variabili che non sono qui sotto non servono e non vanno aggiunte.
# Prima di ogni rilascio: php artisan saas:demo:check-env  (dice QUALI variabili mancano o sono sbagliate, mai i valori).
#
# Un solo indirizzo per tutto: l'app (accesso, gestionale), l'area soci (/area) e i moduli pubblici (/dona, /adesione) rispondono su
# https://demosaas.associazionesemplice.it. «demosaas» è anche il nome (slug) dell'associazione dimostrativa.

APP_NAME="Associazione Semplice (demo)"
APP_ENV=demo                          # mai production: il comando di azzeramento cancella tutto il database
APP_KEY=                              # DA COMPILARE: php artisan key:generate --show (una chiave nuova, non quella della produzione)
APP_DEBUG=false
APP_URL=https://demosaas.associazionesemplice.it   # = SAAS_DEMO_SLUG + "." + SAAS_MEMBERS_DOMAIN
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=daily
LOG_DAILY_DAYS=2                      # l'azzeramento delle 03:30 toglie comunque tutti i log
LOG_LEVEL=warning

# Database proprio della demo: tre utenti PostgreSQL creati da cPanel, con nomi E password diversi tra loro e da quelli della produzione.
DB_CONNECTION=pgsql
DB_HOST=localhost                     # non 127.0.0.1: pg_hba del server demo lo rifiuta. Niente DB_SSLMODE=require: il server non offre SSL su localhost
DB_PORT=5432
DB_DATABASE=                          # DA COMPILARE: il database della demo
DB_USERNAME=                          # DA COMPILARE: utente dell'applicazione
DB_PASSWORD=                          # DA COMPILARE
DB_OWNER_USERNAME=                    # DA COMPILARE: proprietario, migrazioni e azzeramento
DB_OWNER_PASSWORD=                    # DA COMPILARE
DB_BACKUP_USERNAME=                   # DA COMPILARE: sola lettura (obbligatorio per i controlli all'avvio)
DB_BACKUP_PASSWORD=                   # DA COMPILARE

# Cookie: solo per questo indirizzo. Il prefisso __Host- vuole Secure, percorso «/» e nessun Domain: nessun cookie scritto dal
# dominio padre (.associazionesemplice.it, per esempio dalla demo WordPress) può sostituirlo. Vale anche per il cookie delle
# pagine pubbliche (__Host-as_pubblico, messo dall'applicazione quando l'ambiente non è locale).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null                   # mai un dominio: cookie solo per demosaas.associazionesemplice.it
SESSION_COOKIE=__Host-as_demo
SESSION_EXPIRE_ON_CLOSE=true

QUEUE_CONNECTION=database
CACHE_STORE=database                  # niente Redis sulla demo

# Posta: mai inviata, solo nel registro. Nessun server SMTP qui.
MAIL_MAILER=array                     # la posta si scarta (non «log»: indirizzi, codici e link finirebbero nel file di log)
MAIL_FROM_ADDRESS="demo@associazionesemplice.it"
MAIL_FROM_NAME="${APP_NAME}"

# Cifratura: chiave locale (la demo non usa il servizio chiavi: dati finti). Una chiave nuova, solo per la demo.
SAAS_KEY_VAULT=local
SAAS_MASTER_KEY=                      # DA COMPILARE: almeno 32 caratteri casuali, diversi da APP_KEY e da ogni altro posto
SAAS_FILES_ROOT=/home/ACCOUNT/saas-demo/shared/storage/app/org-files   # DA COMPILARE: ACCOUNT = utente cPanel della demo

# Permessi del ruolo di gruppo del database: ogni rilascio li riporta a quelli previsti (saas:db:revoke-group).
SAAS_DB_REVOKE_GROUP=true

# Nessun collegamento col portale: la demo non riceve né invia nulla.
SAAS_UNIFIED_OPERATORS=false          # altrimenti l'accesso rimanda al portale
SAAS_REQUIRE_TWO_FACTOR=false         # solo qui: gli accessi di prova sono pubblici

# Demo.
SAAS_DEMO=true
SAAS_DEMO_DATABASE=                   # DA COMPILARE: lo stesso nome di DB_DATABASE (l'azzeramento notturno si rifiuta se il database collegato è un altro)
SAAS_DEMO_SLUG=demosaas               # nome dell'associazione dimostrativa e primo pezzo dell'indirizzo: area soci su https://demosaas.associazionesemplice.it/area
SAAS_DEMO_PEOPLE=400                  # persone fisiche (da 12 a 1000); l'associazione «grande» è un comando a parte, solo a mano
SAAS_DEMO_PASSWORD=                   # DA COMPILARE, almeno 12 caratteri: la stessa scritta nel pulsante «Prova la demo» (saas:demo:check-env rifiuta vuota o corta; se per errore resta vuota il codice usa la password predefinita, mai una vuota)
SAAS_DEMO_MAIL_DOMAIN=demosaas.associazionesemplice.it

# Area soci: <slug>.<dominio>/area. Con lo slug «demosaas» l'indirizzo è lo stesso dell'app. Il dominio è quello della produzione:
# qui è solo il pezzo che completa l'indirizzo, non c'è nessun collegamento con la produzione.
SAAS_MEMBERS_DOMAIN=associazionesemplice.it
