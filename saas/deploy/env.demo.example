# Configurazione della DEMO del gestionale: si copia in ~/saas-demo/shared/.env (permessi 600) e si compila lì.
# Mai nel repository e mai in chat. Chiavi, database e utenti PostgreSQL sono DIVERSI da quelli della produzione.
# Solo dati inventati: nessuna posta, nessun pagamento vero, nessun file caricato. Si azzera ogni notte alle 03:30.

APP_NAME="Associazione Semplice (demo)"
APP_ENV=demo                          # mai production: il comando di azzeramento cancella tutto il database
APP_KEY=                              # php artisan key:generate --show (una chiave nuova, non quella della produzione)
APP_DEBUG=false
APP_URL=https://app-demo.associazionesemplice.it
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
LOG_LEVEL=warning

# Database proprio della demo: tre utenti PostgreSQL creati da cPanel (nomi diversi dal database e dalla produzione).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=                          # applicazione
DB_PASSWORD=
DB_OWNER_USERNAME=                    # proprietario: migrazioni e azzeramento
DB_OWNER_PASSWORD=
DB_BACKUP_USERNAME=                   # sola lettura (obbligatorio per i controlli all'avvio)
DB_BACKUP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null                    # cookie solo per app-demo.associazionesemplice.it
SESSION_COOKIE=__Host-as_demo
SESSION_EXPIRE_ON_CLOSE=true

QUEUE_CONNECTION=database
CACHE_STORE=database                  # niente Redis sulla demo

# Posta: mai inviata, solo nel registro. Nessun server SMTP qui.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@associazionesemplice.it"
MAIL_FROM_NAME="${APP_NAME}"

# Cifratura: chiave locale (la demo non usa il servizio chiavi: dati finti). Una chiave nuova, solo per la demo.
SAAS_KEY_VAULT=local
SAAS_MASTER_KEY=
SAAS_FILES_ROOT=/home/ACCOUNT/saas-demo/shared/storage/app/org-files

# Nessun collegamento col portale: la demo non riceve né invia nulla.
SAAS_UNIFIED_OPERATORS=false          # altrimenti l'accesso rimanda al portale
SAAS_REQUIRE_TWO_FACTOR=false         # solo qui: gli accessi di prova sono pubblici

# Demo.
SAAS_DEMO=true
SAAS_DEMO_SLUG=demosaas               # nome dell'associazione dimostrativa: area soci su https://demosaas.associazionesemplice.it/area
SAAS_DEMO_PEOPLE=400                  # persone fisiche (da 12 a 1000); l'associazione «grande» è un comando a parte, solo a mano
SAAS_DEMO_PASSWORD=                   # la stessa scritta nel pulsante «Prova la demo» (se vuota: demo-demo-demo-2026)
SAAS_DEMO_MAIL_DOMAIN=demosaas.associazionesemplice.it

# Area soci: <slug>.<dominio>/area. Lo stesso dominio della produzione: i sottodomini veri (app, app-demo, demosaas)
# hanno la precedenza sul jolly della produzione.
SAAS_MEMBERS_DOMAIN=associazionesemplice.it
