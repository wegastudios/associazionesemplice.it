# Configurazione del SaaS sul server: si copia in ~/saas/shared/.env (permessi 600) e si compila lì.
# Mai nel repository e mai in chat. Staging e produzione hanno valori propri: nessuna chiave in comune.

APP_NAME="Associazione Semplice"
APP_ENV=production                    # staging sullo staging
APP_KEY=                              # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://app.associazionesemplice.it
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Database condiviso: tre utenti PostgreSQL creati da cPanel (nomi diversi dal database).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=                          # applicazione
DB_PASSWORD=
DB_OWNER_USERNAME=                    # proprietario: migrazioni
DB_OWNER_PASSWORD=
DB_BACKUP_USERNAME=                   # sola lettura: backup
DB_BACKUP_PASSWORD=
DB_RESTORE_DATABASE=                  # solo staging: database di prova per il ripristino
SAAS_DEDICATED_DB_FILE=/home/ACCOUNT/saas/shared/dedicated-dbs.json

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null                    # senza Domain: il cookie vale solo per app.associazionesemplice.it, non per il sito né per i sottodomini dei soci
SESSION_COOKIE=__Host-as_gestionale    # il prefisso __Host- lo rende impossibile da impostare o leggere da altri indirizzi
SESSION_EXPIRE_ON_CLOSE=true           # senza «ricordami» l'accesso finisce con il browser

QUEUE_CONNECTION=database
# Cache: redis se l'account ha l'estensione e il socket, altrimenti il SaaS usa da sé il database.
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=/home/ACCOUNT/.redis/redis.sock   # socket dell'istanza dedicata
REDIS_PORT=0
REDIS_PASSWORD=null

# Posta, backup SFTP, servizio chiavi e cache si possono impostare anche da /admin/piattaforma (cifrati nel
# database, prendono il posto di questi valori). Senza posta le email finiscono nel log.
MAIL_MAILER=smtp
MAIL_HOST=mail.associazionesemplice.it
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@associazionesemplice.it"
MAIL_FROM_NAME="${APP_NAME}"

# Cifratura: servizio chiavi sull'account separato. Senza indirizzo e chiave di firma il SaaS usa SAAS_MASTER_KEY
# (locale) ed è «di prova»: il portale non può creare associazioni vere finché il servizio non c'è.
SAAS_KEY_VAULT=remote
SAAS_KEY_SERVICE_URL=https://chiavi.EXAMPLE/
SAAS_KEY_SERVICE_SIGNING_KEY=
SAAS_FILES_ROOT=/home/ACCOUNT/saas/shared/storage/app/org-files

# Portale.
SAAS_PORTAL_URL=https://associazionesemplice.it
SAAS_PORTAL_PUBLIC_KEYS=
SAAS_PORTAL_SIGNING_KEY=

# Backup: sul server solo la chiave pubblica. La coppia completa (SAAS_BACKUP_SECRET_KEY) solo sullo staging.
SAAS_BACKUP_PUBLIC_KEY=
SAAS_BACKUP_SECRET_KEY=
SAAS_PG_DUMP=/usr/pgsql-16/bin/pg_dump        # deve essere della versione 16, come il server
SAAS_PG_RESTORE=/usr/pgsql-16/bin/pg_restore
SAAS_BACKUP_DRIVER=sftp
SAAS_BACKUP_SFTP_HOST=
SAAS_BACKUP_SFTP_PORT=23
SAAS_BACKUP_SFTP_USERNAME=
SAAS_BACKUP_SFTP_KEY_PATH=/home/ACCOUNT/.ssh/backup_ed25519
SAAS_BACKUP_SFTP_FINGERPRINT=                 # impronta della chiave del server SFTP
SAAS_BACKUP_SFTP_ROOT=/associazionesemplice
