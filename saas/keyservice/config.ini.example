; Configurazione del servizio chiavi. Copiare in config.ini (fuori dalla cartella pubblica), permessi 600.
; Le chiavi si generano dal SaaS con: php artisan saas:keys:generate

; Chiave principale, base64 di 32 byte. Si custodisce anche offline: senza, nessun dato cifrato si apre più.
master_key = ""

; Chiave pubblica Ed25519 del SaaS (base64). La privata sta solo nell'ambiente del SaaS.
client_public_key = ""

; Indirizzi del SaaS ammessi, separati da virgole.
allowed_ips = ""

; log_file = "/home/account/keyservice/storage/keyservice.log"
; nonce_dir = "/home/account/keyservice/storage/nonces"

; Registro: oltre questa dimensione (byte) passa a keyservice.log.1, .2, ... e se ne tengono log_keep oltre a quello in
; corso. Valori di partenza: 5 MiB e 3 file.
; log_max_bytes = 5242880
; log_keep = 3

; Aperture di chiavi (operazione unwrap) al minuto. Oltre unwrap_alarm_per_minute il servizio scrive «ALLARME» nel
; registro (e manda un'email ad alarm_email, se c'è); oltre unwrap_limit_per_minute risponde 429 e non apre nulla.
; Con molte associazioni (dopo un riavvio dell'applicazione ogni associazione chiede la sua chiave una volta) o con
; `saas:keys:rewrap` su tutte, alzare le soglie per il tempo necessario. 0 spegne il limite o l'allarme.
; unwrap_alarm_per_minute = 100
; unwrap_limit_per_minute = 200
; alarm_email = ""
; rate_dir = "/home/account/keyservice/storage/rate"
