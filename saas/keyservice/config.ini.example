; Configurazione del servizio chiavi. Copiare in config.ini (fuori dalla cartella pubblica), permessi 600.
; Le chiavi si generano dal SaaS con: php artisan saas:keys:generate

; Chiave principale, base64 di 32 byte. Si custodisce anche offline: senza, nessun dato cifrato si apre più.
master_key = ""

; Chiave pubblica Ed25519 del SaaS (base64). La privata sta solo nell'ambiente del SaaS.
client_public_key = ""

; Indirizzi del SaaS ammessi, separati da virgole.
allowed_ips = ""

; log_file = "/home/account/keyservice/storage/keyservice.log"
; nonce_dir = "/home/account/keyservice/storage/nonces"

; Registro: oltre questa dimensione (byte) passa a keyservice.log.1, .2, ... e se ne tengono log_keep oltre a quello in
; corso. Valori di partenza: 5 MiB e 3 file.
; log_max_bytes = 5242880
; log_keep = 3

; Aperture di chiavi (operazione unwrap) al minuto. Oltre la soglia di allarme il servizio scrive «ALLARME» nel registro
; (e manda un'email ad alarm_email, se c'è); oltre il limite risponde 429 e non apre nulla. 0 spegne limite o allarme.
;
; Per ciascuna associazione: le richieste delle pagine e dei lavori di un'associazione contano solo su di lei, quindi
; un'associazione non consuma il tetto delle altre. I nomi di prima, unwrap_alarm_per_minute e
; unwrap_limit_per_minute, valgono ancora e hanno lo stesso significato (ora per associazione).
; unwrap_alarm_per_org_per_minute = 100
; unwrap_limit_per_org_per_minute = 200
;
; Corsia dei comandi che girano su tutte le associazioni (verifica del registro, promemoria, saas:keys:rewrap, ...):
; un solo contatore per tutta la corsia. I comandi fanno una pausa tra un'associazione e l'altra
; (SAAS_KEY_BATCH_PAUSE_MS nel SaaS, partenza 500 ms: al massimo 120 associazioni al minuto).
; batch_unwrap_alarm_per_minute = 250
; batch_unwrap_limit_per_minute = 300
;
; Tutte le aperture del minuto, di ogni associazione e corsia: allarme a 1000; il limite parte spento.
; total_unwrap_alarm_per_minute = 1000
; total_unwrap_limit_per_minute = 0
;
; alarm_email = ""
; rate_dir = "/home/account/keyservice/storage/rate"
