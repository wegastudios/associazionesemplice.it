APP_NAME="Associazione Semplice Supporto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Ruolo di questa istanza: "hub" (portale centrale) oppure "site" (sito di supporto di un portale)
APP_ROLE=site

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wega_support
DB_USERNAME=wega
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@associazionesemplice.it"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=wegastudios.com

VITE_APP_NAME="${APP_NAME}"

# --- Hub: id dei ticket e avvisi ---
# Epoca degli id (secondi trascorsi da questa data, UTC). Non cambiarla dopo l'avvio.
SUPPORT_TICKET_EPOCH=2023-12-27T00:00:00Z
# Sempre avvisati per le priorita 3 e 4 (oltre a quelli del pannello e del portale), separati da virgola
SUPPORT_NOTIFY_EMAILS=info@wegastudios.com

# --- Sito: collegamento all'hub (credenziali ottenute registrando il portale nell'hub) ---
SUPPORT_HUB_URL=
SUPPORT_HUB_TOKEN=
SUPPORT_HUB_TIMEOUT=8
SUPPORT_CUSTOMER_LINK_DAYS=60
# Informativa privacy accettata nel modulo ticket: indirizzo e versione (aumentare la versione se il testo cambia)
SUPPORT_PRIVACY_URL=https://associazionesemplice.it/privacy
SUPPORT_PRIVACY_VERSION=1
