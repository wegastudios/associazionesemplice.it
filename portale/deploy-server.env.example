# Copia questo file come deploy_key.env nella stessa cartella della chiave SSH (deploy_key) e compila i valori.
# deploy_key.env non è tracciato (il repository è pubblico): non committarlo.
PORTALE_HOST=
PORTALE_PORT=
PORTALE_USER=
# Demo su un altro account (facoltativo): se compilati, ogni pubblicazione copia gli zip anche là e lancia update.sh della demo nuova.
# DEMO_KEY = chiave SSH usata solo per la demo, mai quella del portale.
DEMO_HOST=
DEMO_PORT=
DEMO_USER=
DEMO_KEY=
# Sito di supporto (supporto/scripts/deploy.sh): utente@indirizzo del server e porta SSH.
SUPPORTO_HOST=
SUPPORTO_PORT=
